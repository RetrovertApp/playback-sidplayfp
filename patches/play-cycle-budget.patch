+    // Player::play() bounds the cycles that can reach us and the buffer is
+    // sized for that bound, so the split below should never happen. It is here
+    // so that a wrong bound costs samples rather than the heap.
+    const int space = m_bufferpos < m_bufferSize ? m_bufferSize - m_bufferpos : 0;
