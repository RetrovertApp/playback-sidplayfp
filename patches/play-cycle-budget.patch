+        // returns. The event ceiling does; it sits far above the two events per
+        // cycle the scheduler's half-cycle resolution allows.
+        const event_clock_t deadline = m_c64.getTime() + cycles;
+        const unsigned int maxEvents = 4 * cycles + 1024;
